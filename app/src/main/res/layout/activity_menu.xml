<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_menu">


    <!-- Conteúdo da tela -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/logoSnake"
            android:layout_width="300dp"
            android:layout_height="125dp"
            android:layout_marginBottom="40dp"
            android:src="@drawable/logo_snake"
            android:alpha="0"/>

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="280dp"
            android:layout_height="113dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@drawable/botao_play"
            android:contentDescription="play"/>

        <ImageButton
            android:id="@+id/btnRank"
            android:layout_width="280dp"
            android:layout_height="76dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@drawable/botao_rank"
            android:contentDescription="Rank"/>

        <ImageButton
            android:id="@+id/btnCredits"
            android:layout_width="280dp"
            android:layout_height="70dp"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@drawable/botao_credits"
            android:contentDescription="Credits"/>

    </LinearLayout>


</FrameLayout>